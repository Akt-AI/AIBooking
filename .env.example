# Local/server configuration template. Replace blanks locally; never commit real values.
RAILKIT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Generate a random token of at least 24 characters to enable admin APIs.
ADMIN_TOKEN=
AI_DAILY_LIMIT=200
AFFILIATE_ALLOWED_HOSTS=
# Required by compose.pi.yaml for certificate management.
HOSTINGER_API_KEY=
# Direct Node development only; Compose sets DATA_DIR=/app/data.
DATA_DIR=./data
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false
